# Copy to .env and fill in. .env is gitignored.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=""

# service_role key (NOT the anon key).
# Project Settings -> API Keys -> service_role -> Reveal.
# Bypasses Row Level Security; server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Required. Signs session cookies. There is no fallback: signing with an empty
# secret would accept forged cookies.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this signs every user out immediately.
SESSION_SECRET=""
