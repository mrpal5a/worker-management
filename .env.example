# Copy to .env and fill in. .env is gitignored.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=""

# service_role key (NOT the anon key).
# Project Settings -> API Keys -> service_role -> Reveal.
# Bypasses Row Level Security; server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Password for the single shared login to this app.
APP_PASSWORD=""

# Optional. Key used to sign session cookies.
# If unset, APP_PASSWORD is used, which means changing the password signs
# everyone out. Set this to a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
